<Project>

  <PropertyGroup>
    <!-- The two test projects in this directory compile the same sources against different libraries.
         Give each its own obj/bin, or their project.assets.json and runner files collide. -->
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(MSBuildProjectName)\</BaseOutputPath>

    <!-- Keep the sibling project's generated sources out of the default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
